# Coupang Partners Open API credentials (issued from the Partners dashboard).
# Leave blank / keep COUPANG_API_MODE=mock until real keys are available.
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_API_MODE=mock
COUPANG_BATCH_SIZE=50

# Inpock login (single account manages both the harujin and shinjh pages).
INPOCK_EMAIL=
INPOCK_PASSWORD=
INPOCK_HEADLESS=true

# Naver Shopping search (official Open API, developers.naver.com).
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium

STATE_FILE_PATH=data/state.json
LOG_LEVEL=INFO

# Video generation (`video generate`). VIDEO_PROVIDER: higgsfield | topview | hix
# (hix has no public API -- it exports a prompt pack to paste into hix.ai).
VIDEO_PROVIDER=higgsfield
VIDEO_DURATION=5
VIDEO_OUTPUT_DIR=data/videos

# Higgsfield (platform API keys). HF_KEY="key:secret" also works.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
HIGGSFIELD_VIDEO_MODEL=higgsfield-ai/dop/standard

# TopView (open API: Topview-Uid + API key from the TopView dashboard).
TOPVIEW_UID=
TOPVIEW_API_KEY=
TOPVIEW_VIDEO_MODEL=Topview Pro
