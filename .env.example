# ============================================================
# Coupang Partners Open API
# 발급: https://partners.coupang.com > 개발자 센터
# ============================================================
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_API_MODE=mock          # mock | live
COUPANG_BATCH_SIZE=50

# ============================================================
# Inpock (브라우저 자동화)
# https://link.inpock.co.kr
# ============================================================
INPOCK_EMAIL=
INPOCK_PASSWORD=
INPOCK_HEADLESS=true

# ============================================================
# Naver Shopping Search API
# 발급: https://developers.naver.com/apps
# ============================================================
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ============================================================
# TikTok Content Posting API v2
# 발급: https://developers.tiktok.com > 앱 생성 > Content Posting API
# ============================================================
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=           # OAuth2 access token (video.publish scope)

# ============================================================
# YouTube Data API v3
# 발급: https://console.cloud.google.com > API & Services
# OAuth2 인증 필요: youtube.upload scope
# ============================================================
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# ============================================================
# Instagram Graph API (Meta Business)
# 발급: https://developers.facebook.com > 내 앱 > Instagram
# 필요 권한: instagram_content_publish, instagram_basic
# ============================================================
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ============================================================
# Naver Blog API
# 발급: https://developers.naver.com/apps > blog scope
# ============================================================
NAVER_BLOG_CLIENT_ID=
NAVER_BLOG_CLIENT_SECRET=
NAVER_BLOG_ACCESS_TOKEN=       # OAuth2 access token
NAVER_BLOG_ID=                 # 블로그 아이디 (blog.naver.com/<아이디>)

# ============================================================
# 이메일 발송 (Gmail SMTP / App Password)
# Gmail App Password: https://myaccount.google.com/apppasswords
# ============================================================
EMAIL_SENDER=
EMAIL_PASSWORD=                # Gmail App Password (2단계 인증 필요)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_RECIPIENTS=              # 쉼표로 구분: a@gmail.com,b@gmail.com

# ============================================================
# Higgs API (영상 자동 생성)
# 발급: https://higgsfield.ai > API
# ============================================================
HIGGS_API_KEY=

# ============================================================
# Anthropic Claude API (스크립트 자동 생성)
# 발급: https://console.anthropic.com
# ============================================================
ANTHROPIC_API_KEY=

# ============================================================
# 가격 모니터링
# ============================================================
PRICE_MONITOR_INTERVAL_HOURS=6
PRICE_DROP_THRESHOLD_PCT=10    # 이 % 이상 하락시 알림
PRICE_HISTORY_PATH=data/price_history.json

# ============================================================
# 시스템
# ============================================================
PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium
STATE_FILE_PATH=data/state.json
LOG_LEVEL=INFO
