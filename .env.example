# ────────────────────────────────────────────────
# Inpock 계정 (2계정 구성)
# harujin 페이지와 shinjh 페이지 계정이 동일하면
# INPOCK_EMAIL / INPOCK_PASSWORD 만 입력해도 됩니다.
# 서로 다른 계정이면 페이지별 항목을 채워주세요.
# ────────────────────────────────────────────────

# 공통 (두 페이지가 같은 계정일 때)
INPOCK_EMAIL=
INPOCK_PASSWORD=

# harujin 전용 (공통과 다를 때만 입력)
INPOCK_EMAIL_HARUJIN=
INPOCK_PASSWORD_HARUJIN=

# shinjh 전용 (공통과 다를 때만 입력)
INPOCK_EMAIL_SHINJH=
INPOCK_PASSWORD_SHINJH=

# ────────────────────────────────────────────────
# Coupang Partners API (발급 후 입력)
# ────────────────────────────────────────────────
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_API_MODE=mock   # live 로 바꾸면 실제 API 호출

# ────────────────────────────────────────────────
# Naver 검색 API (선택사항)
# ────────────────────────────────────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ────────────────────────────────────────────────
# 기타 설정 (기본값 사용 가능)
# ────────────────────────────────────────────────
INPOCK_HEADLESS=true
LOG_LEVEL=INFO
STATE_FILE_PATH=data/state.json
# PLAYWRIGHT_CHROMIUM_PATH=   # 기본값: /opt/pw-browsers/chromium (Mac은 생략 시 자동 탐색)
