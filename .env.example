# ── Coupang Partners Open API ──────────────────────────────────────────────
# 파트너스 대시보드에서 발급. 키 없이도 COUPANG_API_MODE=mock 으로 드라이런 가능.
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_API_MODE=mock
COUPANG_BATCH_SIZE=50

# ── Inpock RPA ──────────────────────────────────────────────────────────────
# 하나의 계정으로 harujin / shinjh 두 페이지를 관리한다.
INPOCK_EMAIL=
INPOCK_PASSWORD=
INPOCK_HEADLESS=true

# ── Naver Shopping 검색 (공식 Open API) ────────────────────────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── Playwright ──────────────────────────────────────────────────────────────
PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium

STATE_FILE_PATH=data/state.json
LOG_LEVEL=INFO

# ── Meta Developer App ──────────────────────────────────────────────────────
# references/integration.md 에 발급 절차가 설명돼 있다.
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_API_MODE=mock       # mock | live

# ── 계정 1: mom_moneytip (육아·생활 공감) ───────────────────────────────────
META_MOM_MONEYTIP_IG_USER_ID=
META_MOM_MONEYTIP_THREADS_USER_ID=
META_MOM_MONEYTIP_ACCESS_TOKEN=

# ── 계정 2: showpingkkultem (제품 발견·기능 시연) ──────────────────────────
META_SHOWPINGKKULTEM_IG_USER_ID=
META_SHOWPINGKKULTEM_THREADS_USER_ID=
META_SHOWPINGKKULTEM_ACCESS_TOKEN=

# ── 계정 3: haru_moneytip (가격·절약) ──────────────────────────────────────
META_HARU_MONEYTIP_IG_USER_ID=
META_HARU_MONEYTIP_THREADS_USER_ID=
META_HARU_MONEYTIP_ACCESS_TOKEN=

# ── 영상 공개 HTTPS 저장소 ──────────────────────────────────────────────────
# 파일명을 뒤에 붙이면 완성되는 URL 접두어. live 모드에서 필수.
# 예: https://my-bucket.s3.ap-northeast-2.amazonaws.com/shorts/
META_VIDEO_BUCKET_URL=

# ── TTS: Naver Clova Voice ──────────────────────────────────────────────────
NAVER_TTS_CLIENT_ID=
NAVER_TTS_CLIENT_SECRET=
NAVER_TTS_SPEAKER=nara   # nara | mijin | jinho | etc.

# ── 콘텐츠 출력 경로 ────────────────────────────────────────────────────────
CONTENT_OUTPUT_DIR=data/content
PUBLISH_STATE_FILE_PATH=data/publish_state.json
