# Coupang Partners Open API credentials (issued from the Partners dashboard).
# Leave blank / keep COUPANG_API_MODE=mock until real keys are available.
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_API_MODE=mock
COUPANG_BATCH_SIZE=50

# Inpock login (single account manages both the harujin and shinjh pages).
INPOCK_EMAIL=
INPOCK_PASSWORD=
INPOCK_HEADLESS=true

# Naver Shopping search (official Open API, developers.naver.com).
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# OpenAI API for AIDA script auto-generation (platform.openai.com).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium

STATE_FILE_PATH=data/state.json
LOG_LEVEL=INFO
