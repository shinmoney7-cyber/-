# Coupang Partners Open API credentials (issued from the Partners dashboard).
# Leave blank / keep COUPANG_API_MODE=mock until real keys are available.
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_API_MODE=mock
COUPANG_BATCH_SIZE=50

# Inpock login (single account manages both the harujin and shinjh pages).
INPOCK_EMAIL=
INPOCK_PASSWORD=
INPOCK_HEADLESS=true

# Naver Shopping search (official Open API, developers.naver.com).
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# YouTube Data API v3 search (official Open API, console.cloud.google.com).
# Used as the "2차 창작" video-content source (TikTok/Douyin/Xiaohongshu have
# no accessible public search API -- see README). Easiest of the video
# sources to set up -- just an API key, no review process.
YOUTUBE_API_KEY=

# Instagram Graph API hashtag search (developers.facebook.com). Also a
# real video-content source, but harder to set up than YouTube: requires
# an Instagram Business/Creator account linked to a Facebook Page, a Meta
# app, and Meta App Review before it works for anyone but your own test
# users. See docs/CALIBRATION.md.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=

# Video download + auto-stitch ("자동 짜깁기"). VIDEO_MODE=mock (default)
# needs neither yt-dlp nor ffmpeg installed. --live requires both on PATH
# (or YTDLP_PATH/FFMPEG_PATH set) -- see docs/CALIBRATION.md.
VIDEO_MODE=mock
VIDEO_OUTPUT_DIR=data/videos
VIDEO_CLIP_SECONDS=5.0
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# Typecast TTS (typecast.ai). Leave blank / keep TYPECAST_MODE=mock until a
# real key is available. TYPECAST_ACTOR_ID defaults to "예슬" (the only
# voice in the 20-voice catalog confirmed real -- see
# src/shopping_shorts_sync/tts/voices.py and docs/CALIBRATION.md).
TYPECAST_API_KEY=
TYPECAST_MODE=mock
TYPECAST_ACTOR_ID=예슬
TYPECAST_SPEED=1.2

# Publish stage ("발행") -- pushes the stitched video to each platform via
# its official API. Use `publish run --dry-run` (default) until real
# credentials are set -- see docs/CALIBRATION.md before --live use.
#
# TikTok Content Posting API v2 (developers.tiktok.com). Before app review
# passes, videos can only be posted to the developer's own test account.
TIKTOK_ACCESS_TOKEN=
#
# YouTube Data API v3 resumable upload (console.cloud.google.com), OAuth2.
# YOUTUBE_CLIENT_SECRETS_FILE points at the downloaded OAuth client JSON;
# YOUTUBE_TOKEN_FILE is where the one-time browser consent's refresh token
# is cached (run once locally on a machine with a browser, then reuse the
# file on a headless server).
YOUTUBE_CLIENT_SECRETS_FILE=
YOUTUBE_TOKEN_FILE=data/youtube_token.json
#
# Instagram Reels publish reuses INSTAGRAM_ACCESS_TOKEN/INSTAGRAM_IG_USER_ID
# above, plus the instagram_content_publish permission. Instagram requires a
# **public HTTPS URL** for the video, not a local file -- PUBLIC_BASE_URL is
# the deployed webapp's own base URL (e.g. https://your-app.onrender.com),
# used to build that URL from the webapp's /videos/<id>/<file> route.
PUBLIC_BASE_URL=

PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium

STATE_FILE_PATH=data/state.json
LOG_LEVEL=INFO
